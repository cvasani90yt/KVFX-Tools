// KVFX Tools walkthrough: the shot list.
//
// Plain ES3 so After Effects can #include it, and Node can read it too (the
// animatic preview uses the same data).

// When each recording clicks, in seconds (from the clip list in
// scripts/promo-capture.mjs), so a click sound lands on it.
var WT_CLIP_CLICKS = {
  "wt-layouts": [4.4, 5.9, 9.7],
  "wt-motion": [0.6, 1.7, 3.2, 4.7, 7.5],
  "wt-interact": [0.6, 2.65, 5.1, 7.7, 11.1],
  "wt-text": [5.0, 6.3, 7.2, 8.7],
  "wt-kinetic": [1.5, 6.3, 7.1, 8.3],
  "wt-scene": [0.6, 1.7, 2.7, 4.1, 6.1, 8.3, 10.5, 12.7],
  "wt-polish": [1.5, 2.7, 4.1, 6.1, 8.1, 8.6, 9.1, 10.3, 12.5],
  "wt-ship": [1.7, 3.3, 5.9, 7.1, 8.1, 9.5, 10.9, 12.5, 13.9, 15.5, 16.7],
  "wt-tour": [0.6, 1.5, 2.4, 3.3, 4.2, 5.1, 6.0, 6.9],
