{"id":"textanimate","width":1920,"height":1080,"duration":6,"fps":30,"bg":"#0f1014","props":[],"fonts":[{"layer":"Headline","font":"display"}],"runs":[{"label":"Text","at":0,"select":[],"selectProps":[],"selectKeys":[],"undo":"KVFX Walkthrough \u2014 Text","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"text","text":"Numbers that move.","name":"Headline"},"bind":"t"},{"op":"kvfx.op.text.setStyle","args":{"id":{"$ref":"t"},"fontSize":130,"fillColor":[1,1,1],"justification":"center"}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"t"},"path":["ADBE Transform Group","ADBE Position"],"value":[960,580]}}]},{"label":"Animate In + Out","at":0.4,"select":["Headline"],"selectProps":[],"selectKeys":[],"undo":"KVFX Tools \u2014 Animate Text","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.text.addAnimator","args":{"target":"selection","relative":true,"animators":[{"name":"KVFX Blur Rise","properties":[{"matchName":"ADBE Text Opacity","value":0},{"matchName":"ADBE Text Position 3D","value":[0,30,0]},{"matchName":"ADBE Text Blur","value":[20,20]}],"selectors":[{"type":"expression","basedOn":"words","expression":"// KVFX Tools \u2014 text\nvar stagger = 0.066667;\nvar dur = 0.5;\n// The playhead when the animation was added.\nvar start = __KVFX_NOW__;\nfunction kvRank(i, n) { return i; }\nfunction kvMaxRank(n) { return Math.max(0, n - 1); }\nfunction kvEase(t) {\n  var x = t < 0 ? 0 : t > 1 ? 1 : t;\n  return 1 - Math.pow(1 - x, 4);\n}\nvar kvN = textTotal, kvI = textIndex - 1;\nvar kvR = kvRank(kvI, kvN), kvTotal = kvMaxRank(kvN) * stagger + dur;\nfunction kvPhase(t0) { return (time - t0 - kvR * stagger) / dur; }\nvar amt = 0;\nif (time >= start) amt = 100 * (1 - kvEase(kvPhase(start))); else amt = 100;\nvar kvOut = outPoint - kvTotal;\nif (time >= kvOut) amt = 100 * kvEase(kvPhase(kvOut));\nselectorValue * amt / 100;"}]}]}}]}]},
