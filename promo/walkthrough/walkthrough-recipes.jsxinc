h.sqrt(dx * dx + dy * dy);\n    if (len > 1) {\n      var u = (time - key(k).time) / (key(k + 1).time - key(k).time);\n      var s = Math.sin(Math.PI * u) * arc * len;\n      out = []; for (var i = 0; i < value.length; i++) out[i] = value[i];\n      out[0] -= dy / len * s; out[1] += dx / len * s;\n    }\n  }\n}\nout;"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"cursor"},"path":["ADBE Transform Group","ADBE Scale"],"expression":"// KVFX Tools \u2014 cursor lift\nvar lift = 0.08;\nvar v = transform.position.velocity, speed = Math.sqrt(v[0] * v[0] + v[1] * v[1]);\nvar k = 1 + lift * Math.min(1, speed / 1500);\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = i < 2 ? value[i] * k : value[i];\nout;"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"cursor"},"path":["ADBE Transform Group","ADBE Rotate Z"],"expression":"// KVFX Tools \u2014 cursor tilt\nvar tilt = 12;\nvar v = transform.position.velocity[0];\nvalue + Math.max(-tilt, Math.min(tilt, v * 0.012));"}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"cursor"},"matchName":"ADBE Drop Shadow","name":"KVFX Cursor Shadow","params":[{"path":[{"valueType":"oneD","nth":1}],"value":90},{"path":[{"valueType":"oneD","nth":3}],"value":6},{"path":[{"valueType":"oneD","nth":4}],"value":12}]}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"KVFX Metric Cards \u00b7 Card 3"},"path":["ADBE Transform Group","ADBE Scale"],"expression":"// KVFX Tools \u2014 button press\nvar c = __KVFX_NOW__ + 1.215;\nvar u = (time - c) / 0.28;\nvar k = u > 0 && u < 1 ? 1 - 0.06 * Math.sin(Math.PI * u) : 1;\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = i < 2 ? value[i] * k : value[i];\nout;","relative":true,"keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"KVFX Metric Cards \u00b7 Card 2"},"path":["ADBE Transform Group","ADBE Scale"],"expression":"// KVFX Tools \u2014 button press\nvar c = __KVFX_NOW__ + 2.815;\nvar u = (time - c) / 0.28;\nvar k = u > 0 && u < 1 ? 1