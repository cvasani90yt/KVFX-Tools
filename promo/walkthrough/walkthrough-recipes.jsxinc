0);\nvar idle = effect(\"Idle Size\")(1);\nvar t = time - __KVFX_NOW__;\nvar k = 0;\nif (t >= 0) { var front = (t % every) * effect(\"Pulse Speed\")(1); k = Math.max(0, 1 - Math.abs(front - d) / w); }\nvar s = idle + (100 - idle) * k * k * (3 - 2 * k);\n[s, s];"}]},{"name":"Dot 2","items":[{"type":"ellipse","name":"Dot","size":[9,9]},{"type":"fill","name":"Fill","color":[1,0.56,0.25]}],"transform":{"position":[-878.759945481881,-519.2672405120206]},"expressions":[{"path":["ADBE Vector Transform Group","ADBE Vector Scale"],"expression":"// KVFX Tools \u2014 dot pulse\nvar d = 0.9362;\nvar every = Math.max(0.1, effect(\"Pulse Every\")(1));\nvar w = Math.max(0.01, effect(\"Pulse Width\")(1) / 100);\nvar idle = effect(\"Idle Size\")(1);\nvar t = time - __KVFX_NOW__;\nvar k = 0;\nif (t >= 0) { var front = (t % every) * effect(\"Pulse Speed\")(1); k = Math.max(0, 1 - Math.abs(front - d) / w); }\nvar s = idle + (100 - idle) * k * k * (3 - 2 * k);\n[s, s];"}]},{"name":"Dot 3","items":[{"type":"ellipse","name":"Dot","size":[9,9]},{"type":"fill","name":"Fill","color":[1,0.56,0.25]}],"transform":{"position":[-798.8726777108009,-519.2672405120206]},"expressions":[{"path":["ADBE Vector Transform Group","ADBE Vector Scale"],"expression":"// KVFX Tools \u2014 dot pulse\nvar d = 0.8739;\nvar every = Math.max(0.1, effect(\"Pulse Every\")(1));\nvar w = Math.max(0.01, effect(\"Pulse Width\")(1) / 100);\nvar idle = effect(\"Idle Size\")(1);\nvar t = time - __KVFX_NOW__;\nvar k = 0;\nif (t >= 0) { var front = (t % every) * effect(\"Pulse Speed\")(1); k = Math.max(0, 1 - Math.abs(front - d) / w); }\nvar s = idle + (100 - idle) * k * k * (3 - 2 * k);\n[s, s];"}]},{"name":"Dot 4","items":[{"type":"ellipse","name":"Dot","size":[9,9]},{"type":"fill","name":"Fill","color":[1,0.56,0.25]}],"transform":{"position":[-718.9854099397209,-519.2672405120206]},"expressions":[{"path":["ADBE Vector Transform Group","ADBE Vector Scale"],"expression":"// KVFX Tools \u2014 dot pulse\nvar d = 0.8135;\nvar e