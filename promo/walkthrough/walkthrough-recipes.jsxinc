{"id":"cursor","width":1920,"height":1080,"duration":8,"fps":30,"bg":"#0f1014","props":[],"fonts":[],"runs":[{"label":"Build Layout","at":0,"select":[],"selectProps":[],"selectKeys":[],"undo":"KVFX Tools \u2014 Build Layout","budgetMs":30000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"shape","name":"KVFX Pricing Card \u00b7 Card"},"bind":"part0"},{"op":"kvfx.op.shape.build","args":{"id":{"$ref":"part0"},"groups":[{"name":"Card","items":[{"type":"rect","name":"Box","size":[659.936842105263,855.4736842105262],"roundness":43.995789473684205},{"type":"stroke","name":"Edge","color":[0.17647058823529413,0.18823529411764706,0.2235294117647059],"width":2.444210526315789},{"type":"fill","name":"Fill","color":[0.08627450980392157,0.09019607843137255,0.10980392156862745]}]}]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"part0"},"path":["ADBE Transform Group","ADBE Anchor Point"],"value":[0,0,0]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"part0"},"path":["ADBE Transform Group","ADBE Position"],"value":[960,540,0]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"part0"},"matchName":"ADBE Drop Shadow","name":"KVFX Shadow","params":[{"path":[{"valueType":"oneD","nth":1}],"value":110},{"path":[{"valueType":"oneD","nth":2}],"value":180},{"path":[{"valueType":"oneD","nth":3}],"value":21.997894736842103},{"path":[{"valueType":"oneD","nth":4}],"value":73.32631578947368}]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"part0"},"matchName":"ADBE Slider Control","name":"KVFX Reveal","params":[{"path":[1],"value":100}]}},{"op":"kvfx.op.prop.keyframes","args":{"id":{"$ref":"part0"},"path":["ADBE Effect Parade","KVFX Reveal",1],"relative":true,"keys":[{"time":0,"value":0},{"time":0.5333333333333333,"value":100}]}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"part0"},"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 reveal\nfunction kvEase(t) {\n  var x = t < 0 ? 0 : t > 1 ? 1 : t;\n  return x >= 1 ? 1 : 1 - Math.pow(2, -10 * x);\n}\nvar p = effect(\"KVFX Reveal\")(1) / 100;\nvar e = kvEase(p);\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = value[i];\nout[0] += 0;\nout[1] += 61.1053 * (1 - e);\nout;"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"part0"},"path":["ADBE Transform Group","ADBE Opacity"],"expression":"// KVFX Tools \u2014 reveal\nfunction kvEase(t) {\n  var x = t < 0 ? 0 : t > 1 ? 1 : t;\n  return x >= 1 ? 1 : 1 - Math.pow(2, -10 * x);\n}\nvar p = effect(\"KVFX Reveal\")(1) / 100;\nvar e = kvEase(p);\nvalue * Math.max(0, Math.min(1, p * 1.6));"}},{"op":"kvfx.op.layer.create","args":{"kind":"text","text":"Kovo Pro","name":"KVFX Pricing Card \u00b7 Plan"},"bind":"part1"},{"op":"kvfx.op.text.setStyle","args":{"id":{"$ref":"part1"},"fontSize":34.21894736842105,"fillColor":[1,0.5607843137254902,0.24705882352941178],"justification":"left"}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"part1"},"path":["ADBE Transform Group","ADBE Position"],"value":[691.1368421052632,219.80842105263162,0]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"part1"},"matchName":"ADBE Slider Control","name":"KVFX Reveal","params":[{"path":[1],"value":100}]}},{"op":"kvfx.op.prop.keyframes","args":{"id":{"$ref":"part1"},"path":["ADBE Effect Parade","KVFX Reveal",1],"relative":true,"keys":[{"time":0.16666666666666666,"value":0},{"time":0.7,"value":100}]}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"part1"},"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 reveal\nfunction kvEase(t) {\n  var x = t < 0 ? 0 : t > 1 ? 1 : t;\n  return x >= 1 ? 1 : 1 - Math.pow(2, -10 * x);\n}\nvar p = effect(\"KVFX Reveal\")(1) / 100;\nvar e = kvEase(p);\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = value[i];\nout[0] += 0;\nout[1] += 61.1053 * (1 - e);\nout;"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"part1"},"path":["ADBE Transform Group","ADBE Opacity"],"expression":"// KVFX Tools \u2014 reveal\nfunction kvEase(t) {\n  var x = t < 0 ? 0 : t > 1 ? 1 : t;\n  return x >= 1 ? 1 : 1 - Math.pow(2, -10 * x);\n}\nvar p = effect(\"KVFX Reveal\")(1) / 100;\nvar e = kvEase(p);\nvalue * Math.max(0, Math.min(1, p * 1.6));"}},{"op":"kvfx.op.layer.create","args":{"kind":"text","text":"$29","name":"KVFX Pricing Card \u00b7 Price"},"bind":"part2"},{"op":"kvfx.op.text.setStyle","args":{"id":{"$ref":"part2"},"fontSize":112.43368421052631,"fillColor":[0.9568627450980393,0.9568627450980393,0.9607843137254902],"justification":"left"}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"part2"},"path":["ADBE Transform Group","ADBE Position"],"value":[691.1368421052632,344.46315789473687,0]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"part2"},"matchName":"ADBE Slider Control","name":"KVFX Counter"}},{"op":"kvfx.op.prop.keyframes","args":{"id":{"$ref":"part2"},"path":["ADBE Effect Parade","KVFX Counter",1],"relative":true,"bezier":[0.16,1,0.3,1],"keys":[{"time":0.25,"value":0},{"time":1.5833333333333333,"value":100}]}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"part2"},"path":["ADBE Text Properties","ADBE Text Document"],"expression":"// KVFX Tools \u2014 counter\nvar from = 0;\nvar to = 29;\nvar decimals = 0;\nvar separator = \",\";\nvar decimalMark = \".\";\nvar prefix = \"$\";\nvar suffix = \"\";\nvar progress = effect(\"KVFX Counter\")(1) / 100;\nvar n = from + (to - from) * progress;\nvar digits = Math.abs(n).toFixed(decimals).split(\".\");\nvar whole = digits[0];\nvar grouped = \"\";\nwhile (whole.length > 3) {\n  grouped = separator + whole.substr(whole.length - 3) + grouped;\n  whole = whole.substr(0, whole.length - 3);\n}\ngrouped = whole + grouped;\nif (digits.length > 1) grouped += decimalMark + digits[1];\n(n < 0 && Number(Math.abs(n).toFixed(decimals)) !== 0 ? \"-\" : \"\") + prefix + grouped + suffix;"}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"part2"},"matchName":"ADBE Slider Control","name":"KVFX Reveal","params":[{"path":[1],"value":100}]}},{"op":"kvfx.op.prop.