$layer":"KVFX Kanban Board \u00b7 Column Title 1"},"path":["ADBE Effect Parade","KVFX Reveal",1],"relative":true,"keys":[{"time":0.13333333333333333,"value":0},{"time":0.6666666666666666,"value":100}]}},{"op":"kvfx.op.prop.keyframes","args":{"id":{"$layer":"KVFX Kanban Board \u00b7 Column 1"},"path":["ADBE Effect Parade","KVFX Reveal",1],"relative":true,"keys":[{"time":1.7333333333333334,"value":0},{"time":2.2666666666666666,"value":100}]}},{"op":"kvfx.op.prop.expression","args":{"ids":[{"$layer":"KVFX Kanban Board \u00b7 Tag 3.2"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 3.2"},{"$layer":"KVFX Kanban Board \u00b7 Task 3.2"},{"$layer":"KVFX Kanban Board \u00b7 Tag 3.1"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 3.1"},{"$layer":"KVFX Kanban Board \u00b7 Task 3.1"},{"$layer":"KVFX Kanban Board \u00b7 Count 3"},{"$layer":"KVFX Kanban Board \u00b7 Column Title 3"},{"$layer":"KVFX Kanban Board \u00b7 Column 3"},{"$layer":"KVFX Kanban Board \u00b7 Tag 2.2"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 2.2"},{"$layer":"KVFX Kanban Board \u00b7 Task 2.2"},{"$layer":"KVFX Kanban Board \u00b7 Tag 2.1"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 2.1"},{"$layer":"KVFX Kanban Board \u00b7 Task 2.1"},{"$layer":"KVFX Kanban Board \u00b7 Count 2"},{"$layer":"KVFX Kanban Board \u00b7 Column Title 2"},{"$layer":"KVFX Kanban Board \u00b7 Column 2"},{"$layer":"KVFX Kanban Board \u00b7 Tag 1.3"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 1.3"},{"$layer":"KVFX Kanban Board \u00b7 Task 1.3"},{"$layer":"KVFX Kanban Board \u00b7 Tag 1.2"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 1.2"},{"$layer":"KVFX Kanban Board \u00b7 Task 1.2"},{"$layer":"KVFX Kanban Board \u00b7 Tag 1.1"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 1.1"},{"$layer":"KVFX Kanban Board \u00b7 Task 1.1"},{"$layer":"KVFX Kanban Board \u00b7 Count 1"},{"$layer":"KVFX Kanban Board \u00b7 Column Title 1"},{"$layer":"KVFX Kanban Board \u00b7 Column 1"}],"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 reveal\nfunction kvEase(t) {\n  var x = t < 0 ? 0 : t > 1 ? 1 : t;\n  return x >= 1 ? 1 : 1 - Math.pow(2, -10 * x);\n}\nvar p = effect(\"KVFX Reveal\")(1) / 100;\nvar e = kvEase(p);\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = value[i];\nout[0] += -80 * (1 - e);\nout[1] += 0;\nout;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"ids":[{"$layer":"KVFX Kanban Board \u00b7 Tag 3.2"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 3.2"},{"$layer":"KVFX Kanban Board \u00b7 Task 3.2"},{"$layer":"KVFX Kanban Board \u00b7 Tag 3.1"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 3.1"},{"$layer":"KVFX Kanban Board \u00b7 Task 3.1"},{"$layer":"KVFX Kanban Board \u00b7 Count 3"},{"$layer":"KVFX Kanban Board \u00b7 Column Title 3"},{"$layer":"KVFX Kanban Board \u00b7 Column 3"},{"$layer":"KVFX Kanban Board \u00b7 Tag 2.2"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 2.2"},{"$layer":"KVFX Kanban Board \u00b7 Task 2.2"},{"$layer":"KVFX Kanban Board \u00b7 Tag 2.1"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 2.1"},{"$layer":"KVFX Kanban Board \u00b7 Task 2.1"},{"$layer":"KVFX Kanban Board \u00b7 Count 2"},{"$layer":"KVFX Kanban Board \u00b7 Column Title 2"},{"$layer":"KVFX Kanban Board \u00b7 Column 2"},{"$layer":"KVFX Kanban Board \u00b7 Tag 1.3"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 1.3"},{"$layer":"KVFX Kanban Board \u00b7 Task 1.3"},{"$layer":"KVFX Kanban Board \u00b7 Tag 1.2"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 1.2"},{"$layer":"KVFX Kanban Board \u00b7 Task 1.2"},{"$layer":"KVFX Kanban Board \u00b7 Tag 1.1"},{"$layer":"KVFX Kanban Board \u00b7 Task Text 1.1"},{"$layer":"KVFX Kanban Board \u00b7 Task 1.1"},{"$layer":"KVFX Kanban Board \u00b7 Count 1"},{"$layer":"KVFX Kanban Board \u00b7 Column Title 1"},{"$layer":"KVFX Kanban Board \u00b7 Column 1"}],"path":["ADBE Transform Group","ADBE Opacity"],"expression":"// KVFX Tools \u2014 reveal\nfunction kvEase(t) {\n  var x = t < 0 ? 0 : t > 1 ? 1 : t;\n  return x >= 1 ? 1 : 1 - Math.pow(2, -10 * x);\n}\nvar p = effect(\"KVFX Reveal\")(1) / 100;\nvar e = kvEase(p);\nvalue * Math.max(0, Math.min(1, p * 1.6));","keepExisting":true}}]}]},
{"id":"carousel","width":1920,"height":1080,"duration":12,"fps":30,"bg":"#0f1014","props":[{"name":"Card \u00b7 Metrics","stage":"metrics","position":[960,540],"scale":50},{"name":"Card \u00b7 Chat","stage":"lay-chat","position":[960,540],"scale":50},{"name":"Card \u00b7 Notification","stage":"lay-notify","position":[960,540],"scale":50},{"name":"Card \u00b7 Bars","stage":"lay-bars","position":[960,540],"scale":50},{"name":"Card \u00b7 Pricing","stage":"lay-pricing","position":[960,540],"scale":50}],"fonts":[],"runs":[{"label":"Build Card Carousel","at":0,"select":["Card \u00b7 Pricing","Card \u00b7 Bars","Card \u00b7 Notification","Card \u00b7 Chat","Card \u00b7 Metrics"],"selectProps":[],"selectKeys":[],"undo":"KVFX Tools \u2014 Card Carousel","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"null","name":"KVFX Card Carousel"},"bind":"hub"},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"hub"},"path":["ADBE Transform Group","ADBE Position"],"value":[960,540,0]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"hub"},"matchName":"ADBE Slider Control","name":"Index","params":[{"path":[1],"value":0}]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"hub"},"matchName":"ADBE Slider Control","name":"Spacing","params":[{"path":[1],"value":1020}]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"hub"},"matchName":"ADBE Slider Control","name":"Focus Scale","params":[{"path":[1],"value":100}]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"hub"},"matchName":"ADBE Slider Control","name":"Side Scale","params":[{"path":[1],"value":80}]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"hub"},"matchName":"ADBE Slider Control","name":"Side Opacity","params":[{"path":[1],"value":45}]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"hub"},"matchName":"ADBE Slider Control","name":"Hold","params":[{"path":[1],"value":1.2}]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"hub"},"matchName":"ADBE Slider Control","name":"Move","params":[{"path":[1],"value":0.5}]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"hub"},"matchName":"ADBE Slider Control","name":"Visible Cards","params":[{"path":[1],"value":2}]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"hub"},"matchName":"ADBE Checkbox Control","name":"Loop","params":[{"path":[1],"value":1}]}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"hub"},"path":["ADBE Effect Parade","Index",1],"expression":"// KVFX Tools \u2014 card carousel\nvar n = 5;\nvar hold = effect(\"Hold\")(1), move = Math.max(0.01, effect(\"Move\")(1));\nvar loop = effect(\"Loop\")(1) > 0;\nvar t = Math.max(0, time - __KVFX_NOW__), cycle = Math.max(0.01, hold + move);\nvar k = Math.floor(t / cycle);\nvar u = Math.max(0, Math.min(1, (t - k * cycle - hold) / move));\nvar e = u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2;\nloop ? k + e : Math.min(n - 1, k + e);","relative":true}},{"op":"kvfx.op.layer.set","args":{"ids":[{"$layer":"Card \u00b7 Pricing"},{"$layer":"Card \u00b7 Bars"},{"$layer":"Card \u00b7 Notification"},{"$layer":"Card \u00b7 Chat"},{"$layer":"Card \u00b7 Metrics"}],"parent":{"$ref":"hub"}}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Card \u00b7 Pricing"},"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 card carousel\nvar n = 5, slot = 0;\nvar idx = parent.effect(\"Index\")(1);\nvar d = slot - idx;\nif (parent.effect(\"Loop\")(1) > 0) d = d - n * Math.round(d / n);\nvar a = Math.min(1, Math.abs(d));\nvar sp = parent.effect(\"Spacing\")(1);\nvar hub = parent.anchorPoint;\nvar r = sourceRectAtTime(time, false);\nvar cx = r.left + r.width / 2, cy = r.top + r.height / 2;\nvar s = transform.scale;\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = value[i];\nout[0] = hub[0] + d * sp + (anchorPoint[0] - cx) * s[0] / 100;\nout[1] = hub[1] + (anchorPoint[1] - cy) * s[1] / 100;\nout;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Card \u00b7 Pricing"},"path":["ADBE Transform Group","ADBE Scale"],"expression":"// KVFX Tools \u2014 card carousel\nvar n = 5, slot = 0;\nvar idx = parent.effect(\"Index\")(1);\nvar d = slot - idx;\nif (parent.effect(\"Loop\")(1) > 0) d = d - n * Math.round(d / n);\nvar a = Math.min(1, Math.abs(d));\nvar f = parent.effect(\"Focus Scale\")(1), side = parent.effect(\"Side Scale\")(1);\nvar k = (f + (side - f) * a) / 100;\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = i < 2 ? value[i] * k : value[i];\nout;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Card \u00b7 Pricing"},"path":["ADBE Transform Group","ADBE Opacity"],"expression":"// KVFX Tools \u2014 card carousel\nvar n = 5, slot = 0;\nvar idx = parent.effect(\"Index\")(1);\nvar d = slot - idx;\nif (parent.effect(\"Loop\")(1) > 0) d = d - n * Math.round(d / n);\nvar a = Math.min(1, Math.abs(d));\nvar so = parent.effect(\"Side Opacity\")(1), vis = parent.effect(\"Visible Cards\")(1);\nvar o = 100 + (so - 100) * a;\nvar far = Math.abs(d) - vis;\nif (far > 0) o *= Math.max(0, 1 - far);\nvalue * o / 100;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Card \u00b7 Bars"},"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 card carousel\nvar n = 5, slot = 1;\nvar idx = parent.effect(\"Index\")(1);\nvar d = slot - idx;\nif (parent.effect(\"Loop\")(1) > 0) d = d - n * Math.round(d / n);\nvar a = Math.min(1, Math.abs(d));\nvar sp = parent.effect(\"Spacing\")(1);\nvar hub = parent.anchorPoint;\nvar r = sourceRectAtTime(time, false);\nvar cx = r.left + r.width / 2, cy = r.top + r.height / 2;\nvar s = transform.scale;\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = value[i];\nout[0] = hub[0] + d * sp + (anchorPoint[0] - cx) * s[0] / 100;\nout[1] = hub[1] + (anchorPoint[1] - cy) * s[1] / 100;\nout;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Card \u00b7 Bars"},"path":["ADBE Transform Group","ADBE Scale"],"expression":"// KVFX Tools \u2014 card carousel\nvar n = 5, slot = 1;\nvar idx = parent.effect(\"Index\")(1);\nvar d = slot - idx;\nif (parent.effect(\"Loop\")(1) > 0) d = d - n * Math.round(d / n);\nvar a = Math.min(1, Math.abs(d));\nvar f = parent.effect(\"Focus Scale\")(1), side = parent.effect(\"Side Scale\")(1);\nvar k = (f + (side - f) * a) / 100;\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = i < 2 ? value[i] * k : value[i];\nout;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Card \u00b7 Bars"},"path":["ADBE Transform Group","ADBE Opacity"],"expression":"// KVFX Tools \u2014 card carousel\nvar n = 5, slot = 1;\nvar idx = parent.effect(\"Index\")(1);\nvar d = slot - idx;\nif (parent.effect(\"Loop\")(1) > 0) d = d - n * Math.round(d / n);\nvar a = Math.min(1, Math.abs(d));\nvar so = parent.effect(\"Side Opacity\")(1), vis = parent.effect(\"Visible Cards\")(1);\nvar o = 100 + (so - 100) * a;\nvar far = Math.abs(d) - vis;\nif (far > 0) o *= Math.max(0, 1 - far);\nvalue * o / 100;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Card \u00b7 Notification"},"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 card carousel\nvar n = 5, slot = 2;\nvar idx = parent.effect(\"Index\")(1);\nvar d = slot - idx;\nif (parent.effect(\"Loop\")(1) > 0) d = d - n * Math.round(d / n);\nvar a = Math.min(1, Math.abs(d));\nvar sp = parent.effect(\"Spacing\")(1);\nvar hub = parent.anchorPoint;\nvar r = sourceRectAtTime(time, false);\nvar cx = r.left + r.width / 2, cy = r.top + r.height / 2;\nvar s = transform.scale;\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = value[i];\nout[0] = hub[0] + d * sp + (anchorPoint[0] - cx) * s[0] / 100;\nout[1] = hub[1] + (anchorPoint[1] - cy) * s[1] / 100;\nout;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Card \u00b7 Notification"},"path":["ADBE Transform Group","ADBE Scale"],"expression":"// KVFX Tools \u2014 card carousel\nvar n = 5, slot = 2;\nvar idx = parent.effect(\"Index\")(1);\nvar d = slot - idx;\nif (parent.effect(\"Loop\")(1) > 0) d = d - n * Math.round(d / n);\nvar a = Math.min(1, Math.abs(d));\nvar f = parent.effect(\"Focus Scale\")(1), side = parent.effect(\"Side Scale\")(1);\nvar k = (f + (side - f) * a) / 100;\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = i < 2 ? value[i] * k : value[i];\nout;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Card \u00b7 Notification"},"path":["ADBE Transform Group","ADBE Opacity"],"expression":"// KVFX Tools \u2014 card carousel\nvar n = 5, slot = 2;\nvar idx = parent.effect(\"Index\")(1);\nvar d = slot - idx;\nif (parent.effect(\"Loop\")(1) > 0) d = d - n * Math.round(d / n);\nvar a = Math.min(1, Math.abs(d));\nvar so = parent.effect(\"Side Opacity\")(1), vis = parent.effect(\"Visible Cards\")(1);\nvar o = 100 + (so - 100) * a;\nvar far = Math.abs(d) - vis;\nif (far > 0) o *= Math.max(0, 1 - far);\nvalue * o / 100;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Card \u00b7 Chat"},"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 card carousel\nvar n = 5, slot = 3;\nvar idx = parent.effect(\"Index\")(1);\nvar d = slot - idx;\nif (parent.effect(\"Loop\")(1) > 0) d = d - n * Math.round(d / n);\nvar a = Math.min(1, Math.abs(d));\nvar sp = parent.effect(\"Spacing\")(1);\nvar hub = parent.anchorPoint;\nvar r = sourceRectAtTime(time, false);\nvar cx = r.left + r.width / 2, cy = r.top + r.height / 2;\nvar s = transform.scale;\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = value[i];\nout[0] = hub[0] + d * sp + (anchorPoint[0] - cx) * s[0] / 100;\nout[1] = hub[1] + (anchorPoint[1] - cy) * s[1] / 100;\nout;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Card \u00b7 Chat"},"path":["ADBE Transform Group","ADBE Scale"],"expression":"// KVFX Tools \u2014 card carous