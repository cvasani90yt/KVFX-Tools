n;\n      out = []; for (var i = 0; i < value.length; i++) out[i] = value[i];\n      out[0] -= dy / len * s; out[1] += dx / len * s;\n    }\n  }\n}\nout;"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"cursor"},"path":["ADBE Transform Group","ADBE Scale"],"expression":"// KVFX Tools \u2014 cursor lift\nvar lift = 0.08;\nvar v = transform.position.velocity, speed = Math.sqrt(v[0] * v[0] + v[1] * v[1]);\nvar k = 1 + lift * Math.min(1, speed / 1500);\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = i < 2 ? value[i] * k : value[i];\nout;"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"cursor"},"path":["ADBE Transform Group","ADBE Rotate Z"],"expression":"// KVFX Tools \u2014 cursor tilt\nvar tilt = 12;\nvar v = transform.position.velocity[0];\nvalue + Math.max(-tilt, Math.min(tilt, v * 0.012));"}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"cursor"},"matchName":"ADBE Drop Shadow","name":"KVFX Cursor Shadow","params":[{"path":[{"valueType":"oneD","nth":1}],"value":90},{"path":[{"valueType":"oneD","nth":3}],"value":6},{"path":[{"valueType":"oneD","nth":4}],"value":12}]}},{"op":"kvfx.op.layer.create","args":{"kind":"shape","name":"KVFX Click Ripple"},"bind":"ripple"},{"op":"kvfx.op.shape.build","args":{"id":{"$ref":"ripple"},"groups":[{"name":"Ring","items":[{"type":"ellipse","name":"Ring","size":[100,100]},{"type":"stroke","name":"Edge","color":[1,0.56,0.25],"width":4}]}]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"ripple"},"path":["ADBE Transform Group","ADBE Anchor Point"],"value":[0,0,0]}},{"op":"kvfx.op.prop.keyframes","args":{"id":{"$ref":"ripple"},"path":["ADBE Transform Group","ADBE Position"],"relative":true,"interpolation":"hold","keys":[{"time":1.4600000000000002,"value":[1920,1409.9684210526316]}]}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"ripple"},"path":["ADBE Transform Group","ADBE Scale"],"expression":"// KVFX Tools \u2014 click ripple\nvar t0 = __KVFX_NOW__;\nvar clicks = [1.46];\nvar c = -1;\nfor (var i = 0; i < clicks.length; i++) if (time >= t0 + clicks[i]) c = t0 + clicks[i];\nvar u = c < 0 ? 1 : Math.min(1, (time - c) / 0.45);\nvar s = 57.6 * (1 - Math.pow(1 - u, 3));\n[s, s];","relative":true}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"ripple"},"path":["ADBE Transform Group","ADBE Opacity"],"expression":"// KVFX Tools \u2014 click ripple\nvar t0 = __KVFX_NOW__;\nvar clicks = [1.46];\nvar c = -1;\nfor (var i = 0; i < clicks.length; i++) if (time >= t0 + clicks[i]) c = t0 + clicks[i];\nc < 0 ? 0 : 100 * Math.max(0, 1 - (time - c) / 0.45);","relative":true}},{"op":"kvfx.op.layer.place","args":{"ids":[{"$ref":"ripple"}],"below":{"$ref":"cursor"}}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"KVFX Pricing Card \u00b7 Button"},"path":["ADBE Transform Group","ADBE Scale"],"expression":"// KVFX Tools \u2014 button press\nvar c = __KVFX_NOW__ + 1.46;\nvar u = (time - c) / 0.28;\nvar k = u > 0 && u < 1 ? 1 - 0.06 * Math.sin(Math.PI * u) : 1;\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = i < 2 ? value[i] * k : value[i];\nout;","relative":true,"keepExisting":true}}]}]},
