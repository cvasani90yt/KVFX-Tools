{"id":"code","width":1920,"height":1080,"duration":7,"fps":30,"bg":"#0f1014","props":[],"fonts":[{"layer":"KVFX Code Headline","font":"display"},{"layer":"KVFX Code Lines","font":"mono"},{"layer":"KVFX Glyph Field","font":"mono"},{"layer":"KVFX Decode*","font":"mono"}],"runs":[{"label":"Code","at":0.2,"select":[],"selectProps":[],"selectKeys":[],"undo":"KVFX Tools \u2014 Code Glyphs Title","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"text","text":"0","name":"KVFX Glyph Field"},"bind":"glyphs"},{"op":"kvfx.op.text.setStyle","args":{"id":{"$ref":"glyphs"},"fontSize":31,"fillColor":[1,0.56,0.25],"justification":"center","tracking":200}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"glyphs"},"path":["ADBE Text Properties","ADBE Text Document"],"expression":"// KVFX Tools \u2014 glyph field\nvar chars = '01<>/{}[]#$%&*+=?;:ABCDEF0123456789';\nseedRandom(Math.floor(time * 10), true);\nvar s = '';\nfor (var r = 0; r < 28; r++) {\n  for (var c = 0; c < 100; c++) s += chars.charAt(Math.floor(random(chars.length)));\n  if (r < 27) s += '\\r';\n}\ns;"}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"glyphs"},"path":["ADBE Transform Group","ADBE Position"],"value":[960,31,0]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"glyphs"},"path":["ADBE Transform Group","ADBE Opacity"],"value":14}},{"op":"kvfx.op.layer.create","args":{"kind":"text","text":"const scene = compose(layers);","name":"KVFX Code Lines"},"bind":"lines"},{"op":"kvfx.op.text.setStyle","args":{"id":{"$ref":"lines"},"fontSize":25,"fillColor":[1,0.56,0.25],"justification":"left"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"lines"},"path":["ADBE Text Properties","ADBE Text Document"],"expression":"// KVFX Tools \u2014 code lines\nvar lines = [\n  \"const scene = compose(layers);\",\n  \"for (const card of deck) card.rise();\",\n  \"await render({ fps: 60, quality: 'max' });\",\n  \"if (frame.ready) ship(frame);\",\n  \"const ease = curve(0.16, 1, 0.3, 1);\",\n  \"timeline.add(title, { at: '+0.2' });\",\n  \"export default motion(scene);\",\n  \"const glow = light.bloom({ radius: 24 });\",\n  \"while (idea.alive) iterate(idea);\",\n  \"deck.stagger({ each: 3, from: 'center' });\",\n  \"const ui = build(screen, theme.dark);\",\n  \"cursor.moveTo(button).click();\",\n  \"camera.dolly({ z: -400, ease });\",\n  \"metrics.count(0, 12840, { suffix: '+' });\",\n  \"return keyframes.map(k => k.smooth());\",\n  \"status = 'ready to launch';\"\n];\nvar rows = 6;\nvar t = Math.max(0, time - __KVFX_NOW__) * 1.6;\nvar top = Math.floor(t), part = t - top, out = [];\nfor (var i = 0; i < rows; i++) {\n  var line = lines[(top + i) % lines.length];\n  if (i === rows - 1) line = line.substr(0, Math.floor(line.length * part)) + '_';\n  out.push(line);\n}\nout.join('\\r');","relative":true}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"lines"},"path":["ADBE Transform Group","ADBE Position"],"value":[153.6,669.6,0]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"lines"},"path":["ADBE Transform Group","ADBE Opacity"],"value":45}},{"op":"kvfx.op.layer.create","args":{"kind":"text","text":"KOVO API","name":"KVFX Code Headline"},"bind":"headline"},{"op":"kvfx.op.text.setStyle","args":{"id":{"$ref":"headline"},"fontSize":97,"fillColor":[1,1,1],"justification":"center"}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"headline"},"path":["ADBE Transform Group","ADBE Position"],"value":[960,507.59999999999997,0]}},{"op":"kvfx.op.text.addAnimator","args":{"id":{"$ref":"headline"},"relative":true,"animators":[{"name":"KVFX Decode","properties":[{"matchName":"ADBE Text Character Offset","value":26}],"selectors":[{"type":"expression","basedOn":"glyphs","expression":"// KVFX Tools \u2014 text\nvar stagger = 0.05;\nvar dur = 0.466667;\n// The playhead when the animation was added.\nvar start = __KVFX_NOW__;\nfunction kvRank(i, n) {\n  var s = 3, p = [], k, j, t;\n  for (k = 0; k < n; k++) p[k] = k;\n  for (k = n - 1; k > 0; k--) {\n    s = (s * 16807) % 2147483647;\n    j = Math.floor(((s - 1) / 2147483646) * (k + 1));\n    t = p[k]; p[k] = p[j]; p[j] = t;\n  }\n  for (k = 0; k < n; k++) if (p[k] === i) return k;\n  return i;\n}\nfunction kvMaxRank(n) { return Math.max(0, n - 1); }\nfunction kvEase(t) {\n  var x = t < 0 ? 0 : t > 1 ? 1 : t;\n  return x;\n}\nvar kvN = textTotal, kvI = textIndex - 1;\nvar kvR = kvRank(kvI, kvN), kvTotal = kvMaxRank(kvN) * stagger + dur;\nfunction kvPhase(t0) { return (time - t0 - kvR * stagger) / dur; }\nvar kvFrame = Math.floor(time / thisComp.frameDuration);\nseedRandom(textIndex * 7919 + kvFrame, true);\nvar noisy = random(15, 100), amt = 0;\nif (kvPhase(start) < 1) amt = noisy;\nselectorValue * amt / 100;"}]},{"name":"KVFX Decode Reveal","properties":[{"matchName":"ADBE Text Opacity","value":0}],"selectors":[{"type":"expression","basedOn":"glyphs","expression":"// KVFX Tools \u2014 text\nvar stagger = 0.05;\nvar dur = 0.466667;\n// The playhead when the animation was added.\nvar start = __KVFX_NOW__;\nfunction kvRank(i, n) {\n  var s = 3, p = [], k, j, t;\n  for (k = 0; k < n; k++) p[k] = k;\n  for (k = n - 1; k > 0; k--) {\n    s = (s * 16807) % 2147483647;\n    j = Math.floor(((s - 1) / 2147483646) * (k + 1));\n    t = p[k]; p[k] = p[j]; p[j] = t;\n  }\n  for (k = 0; k < n; k++) if (p[k] === i) return k;\n  return i;\n}\nfunction kvMaxRank(n) { return Math.max(0, n - 1); }\nfunction kvEase(t) {\n  var x = t < 0 ? 0 : t > 1 ? 1 : t;\n  return x;\n}\nvar kvN = textTotal, kvI = textIndex - 1;\nvar kvR = kvRank(kvI, kvN), kvTotal = kvMaxRank(kvN) * stagger + dur;\nfunction kvPhase(t0) { return (time - t0 - kvR * stagger) / dur; }\nvar amt = 0;\nif (time >= start) amt = 100 * (1 - kvEase(kvPhase(start))); else amt = 100;\nselectorValue * amt / 100;"}]}]}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"headline"},"path":["ADBE Transform Group","ADBE Opacity"],"expression":"// KVFX Tools \u2014 flicker\nseedRandom(Math.floor(time / thisComp.frameDuration), true);\nvalue * (random() < 0.07 ? random(0.25, 0.7) : 1);"}}]}]},
{"id":"ease","width":1920,"height":1080,"duration":6,"fps":30,"bg":"#0f1014","props":[],"fonts":[],"runs":[{"label":"Card","at":0,"select":[],"selectProps":[],"selectKeys":[],"undo":"KVFX Walkthrough \u2014 Card","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"shape","name":"Card"},"bind":"c"},{"op":"kvfx.op.shape.build","args":{"id":{"$ref":"c"},"groups":[{"name":"Card","items":[{"type":"rect","name":"Box","size":[300,200],"position":[0,0],"roundness":28},{"type":"fill","name":"Fill","color":[1,0.561,0.247],"opacity":100}]}]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"c"},"path":["ADBE Transform Group","ADBE Position"],"value":[520,540]}},{"op":"kvfx.op.prop.keyframes","args":{"id":{"$ref":"c"},"path":["ADBE Transform Group","ADBE Position"],"keys":[{"time":0.6,"value":[520,540]},{"time":1.4,"value":[1400,540]},{"time":2.4,"value":[1400,540]},{"time":3.2,"value":[520,540]},{"time":4.2,"value":[520,540]},{"time":5,"value":[1400,540]}]}}]},{"label":"Apply to Keys","at":0,"select":[],"selectProps":[],"selectKeys":[{"layer":"Card","path":["ADBE Transform Group","ADBE Position"]}],"undo":"KVFX Tools \u2014 Apply Ease","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.keys.ease","args":{"bezier":[0.16,1,0.3,1]}}]}]},
{"id":"elastic","width":1920,"height":1080,"duration":5,"fps":30,"bg":"#0f1014","props":[],"fonts":[],"runs":[{"label":"Card","at":0,"select":[],"selectProps":[],"selectKeys":[],"undo":"KVFX Walkthrough \u2014 Card","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"shape","name":"Card"},"bind":"c"},{"op":"kvfx.op.shape.build","args":{"id":{"$ref":"c"},"groups":[{"name":"Card","items":[{"type":"rect","name":"Box","size":[360,220],"position":[0,0],"roundness":28},{"type":"fill","name":"Fill","color":[1,0.561,0.247],"opacity":100}]}]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"c"},"path":["ADBE Transform Group","ADBE Position"],"value":[520,540]}},{"op":"kvfx.op.prop.keyframes","args":{"id":{"$ref":"c"},"path":["ADBE Transform Group","ADBE Position"],"keys":[{"time":0.6,"value":[520,540]},{"time":1.2,"value":[1400,540]}]}}]},{"label":"Add Elastic","at":0.6,"select":[],"selectProps":[{"layer":"Card","path":["ADBE Transform Group","ADBE Position"]}],"selectKeys":[],"undo":"KVFX Tools \u2014 Add Elastic","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.prop.expressionOnSelected","args":{"requireKeys":true,"expression":"// KVFX Tools \u2014 elastic\nvar amplitude = 0.06;\nvar frequency = 2.4;\nvar decay = 4;\nfunction kvAdd(a, b) {\n  if (a instanceof Array) { var r = []; for (var i = 0; i < a.length; i++) r[i] = a[i] + b[i]; return r; }\n  return a + b;\n}\nfunction kvScale(a, s) {\n  if (a instanceof Array) { var r = []; for (var i = 0; i < a.length; i++) r[i] = a[i] * s; return r; }\n  return a * s;\n}\nvar kvN = 0;\nif (numKeys > 0) {\n  kvN = nearestKey(time).index;\n  if (key(kvN).time > time) kvN--;\n}\nvar kvResult = value;\nif (kvN > 0) {\n  var kvT = time - key(kvN).time;\n  if (kvT > 0) {\n    var kvV = velocityAtTime(key(kvN).time - thisComp.frameDuration / 10);\n    var kvW = amplitude * Math.sin(frequency * kvT * 2 * Math.PI) / Math.exp(decay * kvT);\n    kvResult = kvAdd(value, kvScale(kvV, kvW));\n  }\n}\nkvResult;"}}]}]},
{"id":"bounce","width":1920,"height":1080,"duration":5,"fps":30,"bg":"#0f1014","props":[],"fonts":[],"runs":[{"label":"Ball","at":0,"select":[],"selectProps":[],"selectKeys":[],"undo":"KVFX Walkthrough \u2014 Ball","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"shape","name":"Ball"},"bind":"b"},{"op":"kvfx.op.shape.build","args":{"id":{"$ref":"b"},"groups":[{"name":"Dot","items":[{"type":"ellipse","name":"Disc","size":[160,160],"position":[0,0]},{"type":"fill","name":"Fill","color":[1,0.561,0.247]}]}]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"b"},"path":["ADBE Transform Group","ADBE Position"],"value":[960,200]}},{"op":"kvfx.op.prop.keyframes","args":{"id":{"$ref":"b"},"path":["ADBE Transform Group","ADBE Position"],"keys":[{"time":0.5,"value":[960,200]},{"time":1.1,"value":[960,820]}]}}]},{"label":"Add Bounce","at":0.5,"select":[],"selectProps":[{"layer":"Ball","path":["ADBE Transform Group","ADBE Position"]}],"selectKeys":[],"undo":"KVFX Tools \u2014 Add Bounce","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.prop.expressionOnSelected","args":{"requireKeys":true,"expression":"// KVFX Tools \u2014 bounce\nvar elasticity = 0.6;\nvar gravity = 5000;\nvar maxBounces = 6;\nfunction kvAdd(a, b) {\n  if (a instanceof Array) { var r = []; for (var i = 0; i < a.length; i++) r[i] = a[i] + b[i]; return r; }\n  return a + b;\n}\nfunction kvScale(a, s) {\n  if (a instanceof Array) { var r = []; for (var i = 0; i < a.length; i++) r[i] = a[i] * s; return r; }\n  return a * s;\n}\nvar kvN = 0;\nif (numKeys > 0) {\n  kvN = nearestKey(time).index;\n  if (key(kvN).time > time) kvN--;\n}\nvar kvResult = value;\nif (kvN > 1) {\n  var kvT = time - key(kvN).time;\n  var kvV = velocityAtTime(key(kvN).time - thisComp.frameDuration / 10);\n  var kvSpeed = (kvV instanceof Array) ? length(kvV) : Math.abs(kvV);\n  if (kvT > 0 && kvSpeed > 0) {\n    var kvDir = (kvV instanceof Array) ? kvScale(kvV, -1 / kvSpeed) : (kvV > 0 ? -1 : 1);\n    var kvBounce = kvSpeed * elasticity;\n    var kvSpan = 2 * kvBounce / gravity;\n    var kvStart = 0;\n    var kvCount = 1;\n    while (kvStart + kvSpan < kvT && kvCount < maxBounces) {\n      kvStart += kvSpan;\n      kvBounce *= elasticity;\n      kvSpan *= elasticity;\n      kvCount++;\n    }\n    var kvD = kvT - kvStart;\n    if (kvD < kvSpan) {\n      kvResult = kvAdd(value, kvScale(kvDir, kvD * (kvBounce - gravity * kvD / 2)));\n    }\n  }\n}\nkvResult;"}}]}]},
{"id":"follow","width":1920,"height":1080,"duration":6,"fps":30,"bg":"#0f1014","props":[],"fonts":[{"layer":"Tag","font":"ui"}],"runs":[{"label":"Leader","at":0,"select":[],"selectProps":[],"selectKeys":[],"undo":"KVFX Walkthrough \u2014 Leader","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"shape","name":"Leader"},"bind":"d"},{"op":"kvfx.op.shape.build","args":{"id":{"$ref":"d"},"groups":[{"name":"Dot","items":[{"type":"ellipse","name":"Disc","size":[70,70],"position":[0,0]},{"type":"fill","name":"Fill","color":[1,0.561,0.247]}]}]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"d"},"path":["ADBE Transform Group","ADBE Position"],"value":[360,700]}},{"op":"kvfx.op.prop.keyframes","args":{"id":{"$ref":"d"},"path":["ADBE Transform Group","ADBE Position"],"keys":[{"time":0.4,"value":[360,700]},{"time":1.6,"value":[960,380]},{"time":2.8,"value":[1560,700]},{"time":4,"value":[960,560]}]}},{"op":"kvfx.op.layer.create","args":{"kind":"text","text":"Kovo Pro","name":"Tag"},"bind":"t"},{"op":"kvfx.op.text.setStyle","args":{"id":{"$ref":"t"},"fontSize":44,"fillColor":[1,1,1],"justification":"center"}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"t"},"path":["ADBE Transform Group","ADBE Position"],"value":[360,640]}},{"op":"kvfx.op.layer.create","args":{"kind":"shape","name":"Shadow"},"bind":"s"},{"op":"kvfx.op.shape.build","args":{"id":{"$ref":"s"},"groups":[{"name":"Card","items":[{"type":"rect","name":"Box","size":[90,24],"position":[0,0],"roundness":12},{"type":"fill","name":"Fill","color":[0,0,0],"opacity":35}]}]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"s"},"path":["ADBE Transform Group","ADBE Position"],"value":[360,770]}}]},{"label":"Follow","at":0,"select":["Leader","Tag","Shadow"],"selectProps":[],"selectKeys":[],"undo":"KVFX Tools \u2014 Follow Layer","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.effect.add","args":{"ids":[{"$layer":"Tag"},{"$layer":"Leader"}],"matchName":"ADBE Layer Control","name":"KVFX Follow","params":[{"path":[1],"value":1}]}},{"op":"kvfx.op.effect.add","args":{"ids":[{"$layer":"Tag"},{"$layer":"Leader"}],"matchName":"ADBE Slider Control","name":"KVFX Follow Delay","params":[{"path":[1],"value":0.12}]}},{"op":"kvfx.op.prop.expression","args":{"ids":[{"$layer":"Tag"},{"$layer":"Leader"}],"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 follow\nvar lead = effect(\"KVFX Follow\")(1);\nvar lag = framesToTime(effect(\"KVFX Follow Delay\")(1));\nvar t0 = __KVFX_NOW__;\nvar t = time - lag;\nif (lead == null) { value; } else {\n  var a = lead.toComp(lead.anchorPoint, t);\n  var b = lead.toComp(lead.anchorPoint, t0);\n  if (hasParent) { a = parent.fromComp(a); b = parent.fromComp(b); }\n  var out = [];\n  for (var i = 0; i < value.length; i++) out[i] = value[i] + (i < a.length ? a[i] - b[i] : 0);\n  out;\n}","relative":true,"keepExisting":true}}]}]},
{"id":"align","width":1920,"height":1080,"duration":6,"fps":30,"bg":"#0f1014","props":[],"fonts":[],"runs":[{"label":"Cards","at":0,"select":[],"selectProps":[],"selectKeys":[],"undo":"KVFX Walkthrough \u2014 Cards","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"shape","name":"Card A"},"bind":"a"},{"op":"kvfx.op.shape.build","args":{"id":{"$ref":"a"},"groups":[{"name":"Card","items":[{"type":"rect","name":"Box","size":[300,200],"position":[0,0],"roundness":24},{"type":"fill","name":"Fill","color":[0.149,0.165,0.2],"opacity":100}]}]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"a"},"path":["ADBE Transform Group","ADBE Position"],"value":[380,300]}},{"op":"kvfx.op.layer.create","args":{"kind":"shape","name":"Card B"},"bind":"b"},{"op":"kvfx.op.shape.build","args":{"id":{"$ref":"b"},"groups":[{"name":"Card","items":[{"type":"rect","name":"Box","size":[300,260],"position":[0,0],"roundness":24},{"type":"fill","name":"Fill","color":[0.149,0.165,0.2],"opacity":100}]}]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"b"},"path":["ADBE Transform Group","ADBE Position"],"value":[820,470]}},{"op":"kvfx.op.layer.create","args":{"kind":"shape","name":"Card C"},"bind":"c"},{"op":"kvfx.op.shape.build","args":{"id":{"$ref":"c"},"groups":[{"name":"Card","items":[{"type":"rect","name":"Box","size":[300,180],"position":[0,0],"roundness":24},{"type":"fill","name":"Fill","color":[0.149,0.165,0.2],"opacity":100}]}]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"c"},"path":["ADBE Transform Group","ADBE Position"],"value":[1150,260]}},{"op":"kvfx.op.layer.create","args":{"kind":"shape","name":"Card D"},"bind":"d"},{"op":"kvfx.op.shape.build","args":{"id":{"$ref":"d"},"groups":[{"name":"Card","items":[{"type":"rect","name":"Box","size":[300,220],"position":[0,0],"roundness":24},{"type":"fill","name":"Fill","color":[1,0.561,0.247],"opacity":100}]}]}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"d"},"path":["ADBE Transform Group","ADBE Position"],"value":[1540,430]}}]},{"label":"Align as Group","at":1,"select":["Card A","Card B","Card C","Card D"],"selectProps":[],"selectKeys":[],"undo":"KVFX Tools \u2014 Align Vertical Centre as Group","budgetMs":5000,"animate":true,"steps":[{"op":"kvfx.op.layer.offsetPosition","args":{"changes":[{"id":{"$layer":"Card D"},"dx":0,"dy":155},{"id":{"$layer":"Card C"},"dx":0,"dy":155},{"id":{"$layer":"Card B"},"dx":0,"dy":155},{"id":{"$layer":"Card A"},"dx":0,"dy":155}]}}]},{"label":"Even gaps horizontally","at":3,"select":["Card A","Card B","Card C","Card D"],"selectProps":[],"selectKeys":[],"undo":"KVFX Tools \u2014 Even Gaps Horizontally","budgetMs":5000,"animate":true,"steps":[{"op":"kvfx.op.layer.offsetPosition","args":{"changes":[{"id":{"$layer":"Card B"},"dx":-80,"dy":0},{"id":{"$layer":"Card C"},"dx":-50,"dy":0},{"id":{"$layer":"Card D"},"dx":-80,"dy":0}]}}]}]},
{"id":"counter","width":1920,"height":1080,"duration":4,"fps":30,"bg":"#0f1014","props":[],"fonts":[{"layer":"KVFX Counter","font":"display"}],"runs":[{"label":"Create Counter","at":0.2,"select":[],"selectProps":[],"selectKeys":[],"undo":"KVFX Tools \u2014 Number Counter","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"text","text":"$48,200"},"bind":"counter"},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"counter"},"matchName":"ADBE Slider Control","name":"KVFX Counter"}},{"op":"kvfx.op.prop.keyframes","args":{"id":{"$ref":"counter"},"path":["ADBE Effect Parade","KVFX Counter",1],"keys":[{"time":0,"value":0},{"time":2,"value":100}],"relative":true,"bezier":[0.333,0,0.667,1]}},{"op":"kvfx.op.prop.expression","args":{"id":{"$ref":"counter"},"path":["ADBE Text Properties","ADBE Text Document"],"expression":"// KVFX Tools \u2014 counter\nvar from = 0;\nvar to = 48200;\nvar decimals = 0;\nvar separator = \",\";\nvar decimalMark = \".\";\nvar prefix = \"$\";\nvar suffix = \"\";\nvar progress = effect(\"KVFX Counter\")(1) / 100;\nvar n = from + (to - from) * progress;\nvar digits = Math.abs(n).toFixed(decimals).split(\".\");\nvar whole = digits[0];\nvar grouped = \"\";\nwhile (whole.length > 3) {\n  grouped = separator + whole.substr(whole.length - 3) + grouped;\n  whole = whole.substr(0, whole.length - 3);\n}\ngrouped = whole + grouped;\nif (digits.length > 1) grouped += decimalMark + digits[1];\n(n < 0 && Number(Math.abs(n).toFixed(decimals)) !== 0 ? \"-\" : \"\") + prefix + grouped + suffix;"}},{"op":"kvfx.op.layer.set","args":{"id":{"$ref":"counter"},"name":"KVFX Counter"}}]}]},
{"id":"carousel3d","width":1920,"height":1080,"duration":6,"fps":30,"bg":"#0f1014","props":[{"name":"Panel \u00b7 Metrics","stage":"metrics","position":[960,540],"scale":34},{"name":"Panel \u00b7 Chat","stage":"lay-chat","position":[960,540],"scale":34},{"name":"Panel \u00b7 Bars","stage":"lay-bars","position":[960,540],"scale":34},{"name":"Panel \u00b7 Pricing","stage":"lay-pricing","position":[960,540],"scale":34},{"name":"Panel \u00b7 Notification","stage":"lay-notify","position":[960,540],"scale":34}],"fonts":[],"runs":[{"label":"Build Carousel","at":0,"select":["Panel \u00b7 Notification","Panel \u00b7 Pricing","Panel \u00b7 Bars","Panel \u00b7 Chat","Panel \u00b7 Metrics"],"selectProps":[],"selectKeys":[],"undo":"KVFX Tools \u2014 3D Carousel","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"null","name":"KVFX Carousel"},"bind":"hub"},{"op":"kvfx.op.layer.setFlag","args":{"target":"ids","ids":[{"$ref":"hub"}],"flag":"threeD","value":true}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"hub"},"matchName":"ADBE Slider Control","name":"Radius","params":[{"path":[1],"value":900}]}},{"op":"kvfx.op.effect.add","args":{"id":{"$ref":"hub"},"matchName":"ADBE Angle Control","name":"Spin"}},{"op":"kvfx.op.layer.setFlag","args":{"target":"ids","ids":[{"$layer":"Panel \u00b7 Notification"},{"$layer":"Panel \u00b7 Pricing"},{"$layer":"Panel \u00b7 Bars"},{"$layer":"Panel \u00b7 Chat"},{"$layer":"Panel \u00b7 Metrics"}],"flag":"threeD","value":true}},{"op":"kvfx.op.layer.set","args":{"ids":[{"$layer":"Panel \u00b7 Notification"},{"$layer":"Panel \u00b7 Pricing"},{"$layer":"Panel \u00b7 Bars"},{"$layer":"Panel \u00b7 Chat"},{"$layer":"Panel \u00b7 Metrics"}],"parent":{"$ref":"hub"}}},{"op":"kvfx.op.prop.expression","args":{"ids":[{"$layer":"Panel \u00b7 Notification"},{"$layer":"Panel \u00b7 Pricing"},{"$layer":"Panel \u00b7 Bars"},{"$layer":"Panel \u00b7 Chat"},{"$layer":"Panel \u00b7 Metrics"}],"path":["ADBE Transform Group","ADBE Orientation"],"expression":"// KVFX Tools \u2014 carousel\nlookAt(position, parent.anchorPoint);"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Panel \u00b7 Notification"},"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 carousel\nvar count = 5;\nvar slot = 0;\nvar radius = parent.effect(\"Radius\")(1);\nvar spin = parent.effect(\"Spin\")(1);\nvar a = degreesToRadians(spin + slot * 360 / count);\nvar c = parent.anchorPoint;\n[c[0] + radius * Math.sin(a), c[1], c[2] - radius * Math.cos(a)];"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Panel \u00b7 Pricing"},"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 carousel\nvar count = 5;\nvar slot = 1;\nvar radius = parent.effect(\"Radius\")(1);\nvar spin = parent.effect(\"Spin\")(1);\nvar a = degreesToRadians(spin + slot * 360 / count);\nvar c = parent.anchorPoint;\n[c[0] + radius * Math.sin(a), c[1], c[2] - radius * Math.cos(a)];"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Panel \u00b7 Bars"},"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 carousel\nvar count = 5;\nvar slot = 2;\nvar radius = parent.effect(\"Radius\")(1);\nvar spin = parent.effect(\"Spin\")(1);\nvar a = degreesToRadians(spin + slot * 360 / count);\nvar c = parent.anchorPoint;\n[c[0] + radius * Math.sin(a), c[1], c[2] - radius * Math.cos(a)];"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Panel \u00b7 Chat"},"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 carousel\nvar count = 5;\nvar slot = 3;\nvar radius = parent.effect(\"Radius\")(1);\nvar spin = parent.effect(\"Spin\")(1);\nvar a = degreesToRadians(spin + slot * 360 / count);\nvar c = parent.anchorPoint;\n[c[0] + radius * Math.sin(a), c[1], c[2] - radius * Math.cos(a)];"}},{"op":"kvfx.op.prop.expression","args":{"id":{"$layer":"Panel \u00b7 Metrics"},"path":["ADBE Transform Group","ADBE Position"],"expression":"// KVFX Tools \u2014 carousel\nvar count = 5;\nvar slot = 4;\nvar radius = parent.effect(\"Radius\")(1);\nvar spin = parent.effect(\"Spin\")(1);\nvar a = degreesToRadians(spin + slot * 360 / count);\nvar c = parent.anchorPoint;\n[c[0] + radius * Math.sin(a), c[1], c[2] - radius * Math.cos(a)];"}}]}]},
{"id":"explode","width":1920,"height":1080,"duration":4,"fps":30,"bg":"#0f1014","props":[],"fonts":[{"layer":"Word","font":"display"}],"runs":[{"label":"Text","at":0,"select":[],"selectProps":[],"selectKeys":[],"undo":"KVFX Walkthrough \u2014 Text","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.layer.create","args":{"kind":"text","text":"KOVO","name":"Word"},"bind":"w"},{"op":"kvfx.op.text.setStyle","args":{"id":{"$ref":"w"},"fontSize":260,"fillColor":[1,0.561,0.247],"justification":"center"}},{"op":"kvfx.op.prop.set","args":{"id":{"$ref":"w"},"path":["ADBE Transform Group","ADBE Position"],"value":[960,640]}}]},{"label":"Explode","at":0,"select":["Word"],"selectProps":[],"selectKeys":[],"undo":"KVFX Tools \u2014 Explode Text","budgetMs":30000,"animate":false,"steps":[{"op":"kvfx.op.text.explode","args":{"id":{"$layer":"Word"},"ranges":[{"start":0,"end":1,"name":"K"},{"start":1,"end":2,"name":"O"},{"start":2,"end":3,"name":"V"},{"start":3,"end":4,"name":"O"}]}}]},{"label":"Stagger In","at":0.3,"select":["Word"],"selectProps":[],"selectKeys":[],"undo":"KVFX Tools \u2014 UI Stagger","budgetMs":5000,"animate":false,"steps":[{"op":"kvfx.op.effect.add","args":{"ids":[{"$layer":"Word"}],"matchName":"ADBE Slider Control","name":"KVFX Reveal","params":[{"path":[1],"value":100}]}},{"op":"kvfx.op.prop.keyframes","args":{"id":{"$layer":"Word"},"path":["ADBE Effect Parade","KVFX Reveal",1],"relative":true,"keys":[{"time":0,"value":0},{"time":0.4666666666666667,"value":100}]}},{"op":"kvfx.op.prop.expression","args":{"ids":[{"$layer":"Word"}],"path":["ADBE Transform Group","ADBE Scale"],"expression":"// KVFX Tools \u2014 reveal\nfunction kvEase(t) {\n  var x = t < 0 ? 0 : t > 1 ? 1 : t;\n  var c1 = 1.701, u = x - 1;\n  return 1 + (c1 + 1) * u * u * u + c1 * u * u;\n}\nvar p = effect(\"KVFX Reveal\")(1) / 100;\nvar e = kvEase(p);\nvar k = (0 + (100 - 0) * e) / 100;\nvar out = []; for (var i = 0; i < value.length; i++) out[i] = value[i] * k;\nout;","keepExisting":true}},{"op":"kvfx.op.prop.expression","args":{"ids":[{"$layer":"Word"}],"path":["ADBE Transform Group","ADBE Opacity"],"expression":"// KVFX Tools \u2014 reveal\nfunction kvEase(t) {\n  var x = t < 0 ? 0 : t > 1 ? 1 : t;\n  var c1 = 1.701, u = x - 1;\n  return 1 + (c1 + 1) * u * u * u + c1 * u * u;\n}\nvar p = effect(\"KVFX Reveal\")(1) / 100;\nvar e = kvEase(p);\nvalue * Math.max(0, Math.min(1, p * 1.6));","keepExisting":true}}]}]}
